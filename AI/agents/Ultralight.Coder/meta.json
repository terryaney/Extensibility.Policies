{
  "id": "Ultralight.Coder",
  "name": "Ultralight (Coder)",
  "description": "Writes code following mandatory coding principles.",
  "enabled": {
    "vscode": true,
    "copilotCli": true,
    "claude": true
  },
  "models": {
    "vscode": "GPT-5.3-Codex (copilot)",
    "copilotCli": "gpt-5.3-codex",
    "claude": "default"
  },
  "tools": {
    "copilot": [
      "vscode",
      "execute",
      "read",
      "agent",
      "io.github.upstash/context7/*",
      "github/*",
      "edit",
      "search",
      "web",
      "vscode/memory",
      "todo"
    ],
    "claude": "auto"
  },
  "copilot": {
    "userInvocable": false
  },
  "claude": {
    "target": "agent"
  }
}