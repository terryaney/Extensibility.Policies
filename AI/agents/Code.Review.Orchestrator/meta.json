{
  "id": "Code.Review.Orchestrator",
  "name": ".NET Core Code Review",
  "description": "Run three parallel code reviews (GPT, Gemini, Codex)",
  "enabled": {
    "vscode": true,
    "copilotCli": true,
    "claude": true
  },
  "models": {
    "vscode": "GPT-5.4 (copilot)",
    "copilotCli": "gpt-5.4",
    "claude": "default"
  },
  "tools": {
    "copilot": [
      "read/readFile",
      "agent",
      "vscode/memory"
    ],
    "claude": "auto"
  },
  "copilot": {
    "userInvocable": true,
    "agents": [
      "Reviewer (GPT)",
      "Reviewer (Gemini)",
      "Reviewer (Codex)"
    ]
  },
  "claude": {
    "target": "agent"
  }
}