{
	"id": "Code.Review.Orchestrator",
	"name": ".NET Core Code Review",
	"description": "Run three parallel code reviews (GPT, Gemini, Codex)",
	"enabled": {
		"copilot": true,
		"claude": true
	},
	"agents": {
		"model": "GPT-5.4 (copilot)",
		"tools": [
			"read/readFile",
			"agent",
			"edit",
			"vscode/memory"
		],
		"userInvocable": true,
		"subAgents": [
			"Reviewer (GPT)",
			"Reviewer (Gemini)",
			"Reviewer (Codex)"
		]
	}
}