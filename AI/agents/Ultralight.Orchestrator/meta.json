{
  "id": "Ultralight.Orchestrator",
  "name": "Ultralight Orchestrator",
  "description": "Delegate prompts via GPT-5.4 to Planner (GPT-5.2), Coder (GPT-5.3-Codex), and Designer (Gemini 3 Pro (Preview))",
  "enabled": {
    "vscode": true,
    "copilotCli": true,
    "claude": true
  },
  "models": {
    "vscode": "GPT-5.4 (copilot)",
    "copilotCli": "gpt-5.4",
    "claude": "default"
  },
  "tools": {
    "copilot": [
      "read/readFile",
      "agent",
      "vscode/memory"
    ],
    "claude": "auto"
  },
  "copilot": {
    "userInvocable": true,
    "agents": [
      "Ultralight (Planner)",
      "Ultralight (Designer)",
      "Ultralight (Coder)"
    ]
  },
  "claude": {
    "target": "agent"
  }
}