{
  "id": "Code.Review.Gemini",
  "name": "Reviewer (Gemini)",
  "description": "Subagent controlled by * Code Review Orchestrator (NO STANDALONE USE)",
  "enabled": {
    "vscode": true,
    "copilotCli": true,
    "claude": true
  },
  "models": {
    "vscode": "Gemini 3 Pro (Preview) (copilot)",
    "copilotCli": "gemini-3-pro-preview",
    "claude": "default"
  },
  "tools": {
    "copilot": [
      "search",
      "read/problems",
      "read/terminalLastCommand",
      "web/githubRepo",
      "io.github.upstash/context7/*"
    ],
    "claude": "auto"
  },
  "copilot": {
    "userInvocable": false
  },
  "claude": {
    "target": "agent"
  }
}