{
	"id": "Code.Review.Gemini",
	"name": "Reviewer (Gemini)",
	"description": "Subagent controlled by * Code Review Orchestrator (NO STANDALONE USE)",
	"enabled": {
		"vscode": true,
		"copilotCli": true,
		"claude": true
	},
	"models": {
		"vscode": "Gemini 3 Pro (Preview) (copilot)",
		"copilotCli": "gemini-3-pro-preview",
		"claude": "default"
	},
	"tools": {
		// search -> Claude Grep + Glob
		"search": {
			"claude": [
				"Grep",
				"Glob"
			]
		},
		// read/problems -> Claude Read
		"read/problems": {
			"claude": "Read"
		},
		// read/terminalLastCommand -> Claude Read
		"read/terminalLastCommand": {
			"claude": "Read"
		},
		// web/githubRepo -> Claude WebFetch
		"web/githubRepo": {
			"claude": "WebFetch"
		},
		// Context7 MCP -> explicit Claude MCP tool names
		"io.github.upstash/context7/*": {
			"claude": [
				"mcp__context7__resolve-library-id",
				"mcp__context7__get-library-docs"
			]
		}
	},
	"copilot": {
		"userInvocable": false
	},
	"claude": {
		"target": "agent"
	}
}