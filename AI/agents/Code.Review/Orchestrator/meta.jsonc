{
	"id": "Code.Review.Orchestrator",
	"name": ".NET Core Code Review",
	"description": "Run three parallel code reviews (GPT, Gemini, Codex)",
	"metadata": {
		"author": "pierceboggan",
		"repository": "https://github.com/pierceboggan/coloring-book/",
		"path": "prompts/code-review.prompt.md",
		"commit": "61f06e8"
	},
	"enabled": {
		"copilot": false,
		"claude": false
	},
	"agents": {
		"model": "GPT-5.4 (copilot)",
		"tools": [
			"read/readFile",
			"agent",
			"edit",
			"vscode/memory"
		],
		"userInvocable": true,
		"subAgents": [
			"Reviewer (GPT)",
			"Reviewer (Gemini)",
			"Reviewer (Codex)"
		]
	}
}