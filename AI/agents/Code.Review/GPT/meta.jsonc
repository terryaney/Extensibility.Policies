{
	"id": "Code.Review.GPT",
	"name": "Reviewer (GPT)",
	"description": "Subagent controlled by .NET Core Code Review (NO STANDALONE USE)",
	"enabled": {
		"copilot": false,
		"claude": false
	},
	"agents": {
		"model": "GPT-5.4 (copilot)",
		"tools": [
			"search",
			"read/problems",
			"read/terminalLastCommand",
			"web/githubRepo",
			"io.github.upstash/context7/*"
		],
		"userInvocable": false,
		"handoffs": [
			{
				"agent": "agent",
				"prompt": "Fix the issues identified in the code review above.",
				"send": false,
				"label": "Fix Issues"
			}
		]
	}
}