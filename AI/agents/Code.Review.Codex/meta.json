{
  "id": "Code.Review.Codex",
  "name": "Reviewer (Codex)",
  "description": "Subagent controlled by * Code Review Orchestrator (NO STANDALONE USE)",
  "enabled": {
    "vscode": true,
    "copilotCli": true,
    "claude": true
  },
  "models": {
    "vscode": "GPT-5.3-Codex (copilot)",
    "copilotCli": "gpt-5.3-codex",
    "claude": "default"
  },
  "tools": {
    "copilot": [
      "search",
      "read/problems",
      "read/terminalLastCommand",
      "web/githubRepo",
      "io.github.upstash/context7/*"
    ],
    "claude": "auto"
  },
  "copilot": {
    "userInvocable": false
  },
  "claude": {
    "target": "agent"
  }
}