{
  "id": "Code.Review.GPT",
  "name": "Reviewer (GPT)",
  "description": "Subagent controlled by * Code Review Orchestrator (NO STANDALONE USE)",
  "enabled": {
    "vscode": true,
    "copilotCli": true,
    "claude": true
  },
  "models": {
    "vscode": "GPT-5.4 (copilot)",
    "copilotCli": "gpt-5.4",
    "claude": "default"
  },
  "tools": {
    "copilot": [
      "search",
      "read/problems",
      "read/terminalLastCommand",
      "web/githubRepo",
      "io.github.upstash/context7/*"
    ],
    "claude": "auto"
  },
  "copilot": {
    "userInvocable": false,
    "handoffs": [
      {
        "agent": "agent",
        "prompt": "Fix the issues identified in the code review above.",
        "send": false,
        "label": "Fix Issues"
      }
    ]
  },
  "claude": {
    "target": "agent"
  }
}