{
	"id": "Code.Review.GPT",
	"name": "Reviewer (GPT)",
	"description": "Subagent controlled by * Code Review Orchestrator (NO STANDALONE USE)",
	"enabled": {
		"vscode": true,
		"copilotCli": true,
		"claude": true
	},
	"models": {
		"vscode": "GPT-5.4 (copilot)",
		"copilotCli": "gpt-5.4",
		"claude": "default"
	},
	"tools": {
		// search -> Claude Grep + Glob
		"search": {
			"claude": [
				"Grep",
				"Glob"
			]
		},
		// read/problems -> Claude Read
		"read/problems": {
			"claude": "Read"
		},
		// read/terminalLastCommand -> Claude Read
		"read/terminalLastCommand": {
			"claude": "Read"
		},
		// web/githubRepo -> Claude WebFetch
		"web/githubRepo": {
			"claude": "WebFetch"
		},
		// Context7 MCP -> explicit Claude MCP tool names
		"io.github.upstash/context7/*": {
			"claude": [
				"mcp__context7__resolve-library-id",
				"mcp__context7__get-library-docs"
			]
		}
	},
	"copilot": {
		"userInvocable": false,
		"handoffs": [
			{
				"agent": "agent",
				"prompt": "Fix the issues identified in the code review above.",
				"send": false,
				"label": "Fix Issues"
			}
		]
	},
	"claude": {
		"target": "agent"
	}
}