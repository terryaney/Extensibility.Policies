{
	"id": "Ultralight.Coder",
	"name": "Ultralight (Coder)",
	"description": "Writes code following mandatory coding principles.",
	"enabled": {
		"copilot": true,
		"claude": true
	},
	"agents": {
		"model": "GPT-5.3-Codex (copilot)",
		"tools": [
			"vscode",
			"vscode/memory",
			"execute",
			"read",
			"agent",
			"io.github.upstash/context7/*",
			"github/*",
			"edit",
			"search",
			"web",
			"todo"
		],
		"userInvocable": false
	}
}