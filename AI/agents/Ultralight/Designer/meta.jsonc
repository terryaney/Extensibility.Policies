{
	"id": "Ultralight.Designer",
	"name": "Ultralight (Designer)",
	"description": "Handles all UI/UX design tasks.",
	"enabled": {
		"copilot": true,
		"claude": true
	},
	"agents": {
		"model": "Gemini 3 Pro (Preview) (copilot)",
		"tools": [
			"vscode",
			"vscode/memory",
			"execute",
			"read",
			"agent",
			"io.github.upstash/context7/*",
			"edit",
			"search",
			"web",
			"todo"
		],
		"userInvocable": false
	}
}