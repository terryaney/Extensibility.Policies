{
  "id": "Ultralight.Designer",
  "name": "Ultralight (Designer)",
  "description": "Handles all UI/UX design tasks.",
  "enabled": {
    "vscode": true,
    "copilotCli": true,
    "claude": true
  },
  "models": {
    "vscode": "Gemini 3 Pro (Preview) (copilot)",
    "copilotCli": "gemini-3-pro-preview",
    "claude": "default"
  },
  "tools": {
    "copilot": [
      "vscode",
      "execute",
      "read",
      "agent",
      "io.github.upstash/context7/*",
      "edit",
      "search",
      "web",
      "vscode/memory",
      "todo"
    ],
    "claude": "auto"
  },
  "copilot": {
    "userInvocable": false
  },
  "claude": {
    "target": "agent"
  }
}