{
	"id": "Anvil",
	"name": "Anvil",
	"description": "Evidence-first coding agent. Verifies before presenting. Attacks its own output. Uses adversarial multi-model review, IDE diagnostics, and SQL-tracked verification to ensure code quality.",
	"metadata": {
		"author": "burkeholland",
		"repository": "https://github.com/burkeholland/anvil/",
		"path": "agents/anvil.agent.md",
		"commit": "ae17066"
	},
	"enabled": {
		"copilot.cli": true,
		"copilot.vscode": true,
		"claude": false
	},
	"bodyReplacements": {
		"copilot.vscode": {
			"`ask_user`": "`vscode/askQuestions`",
			"`session_store`": "`session_store_sql`",
			"`ide-get_diagnostics`": "`read/problems`"
		}
	},
	"agents": {
		"model": "GPT-5.3-Codex (copilot)",
		"tools": [
			"vscode/askQuestions",
			"agent",
			"vscode/memory",
			"io.github.upstash/context7/*"
		],
		"userInvocable": true
	}
}