		"author": "anthropics",
		"repository": "https://github.com/anthropics/skills",
		"commit": "690f15c"
	},
	"enabled": {
		"copilot": false,
		"claude": false
	},
	"skills": {
		"excludeItems": {
			"copilot": [ "agents", "assets", "eval-viewer", "scripts" ]
		}
	}
}
